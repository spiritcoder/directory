<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>
<body>
  <%- include('partials/header') %>
  
  <!-- Hero Section -->
  <section class="restaurant-hero">
    <div class="hero-background">
      <% if (tattooShop.images && tattooShop.images.length > 0) { %>
        <img src="<%= tattooShop.images[0] %>" alt="<%= tattooShop.businessName %>" class="hero-image">
      <% } %>
      <div class="hero-overlay"></div>
    </div>
    <div class="hero-content">
      <nav class="breadcrumb">
        <a href="/">Home</a> > 
        <a href="/state/<%= tattooShop.address.state.toLowerCase().replace(/\s+/g, '-') %>"><%= tattooShop.address.state %></a> > 
        <span><%= tattooShop.businessName %></span>
      </nav>
      <h1 class="hero-title"><%= tattooShop.businessName %></h1>
      <div class="hero-meta">
        <span class="hero-rating">⭐ <%= tattooShop.rating %>/5</span>
        <span class="hero-reviews">(<%= tattooShop.reviewCount %> reviews)</span>
        <% if (tattooShop.priceRange) { %>
          <span class="hero-price">💰 <%= tattooShop.priceRange %></span>
        <% } %>
        <span class="hero-category"><%= tattooShop.category %></span>
      </div>
      <p class="hero-address">
        📍 <%= tattooShop.address.street %>, <%= tattooShop.address.city %>, <%= tattooShop.address.state %>
      </p>
    </div>
  </section>

  <main class="container-wide">
    <div class="restaurant-layout">
      <article class="restaurant-main">

      <!-- Tattoo Shop Overview -->
      <section class="restaurant-overview">
        <div class="overview-grid">
          <!-- Main Info Panel -->
          <div class="main-info-panel">
            <div class="panel-header">
              <h2 class="panel-title">Tattoo Shop Information</h2>
              <div class="panel-rating-badge">
                <span class="rating-stars">⭐⭐⭐⭐⭐</span>
                <span class="rating-text"><%= tattooShop.rating %>/5.0 • <%= tattooShop.reviewCount %> reviews</span>
              </div>
            </div>
            
            <div class="info-list">
              <div class="info-item">
                <div class="info-label">📍 Address</div>
                <div class="info-value">
                  <%= tattooShop.address.street %><br>
                  <%= tattooShop.address.city %>, <%= tattooShop.address.state %> <%= tattooShop.address.zipCode %>
                </div>
              </div>
              
              <% if (tattooShop.phone) { %>
              <div class="info-item">
                <div class="info-label">📞 Phone</div>
                <div class="info-value">
                  <a href="tel:<%= tattooShop.phone %>" class="contact-link"><%= tattooShop.phone %></a>
                </div>
              </div>
              <% } %>
              
              <% if (tattooShop.website) { %>
              <div class="info-item">
                <div class="info-label">🌐 Website</div>
                <div class="info-value">
                  <a href="<%= tattooShop.website %>" target="_blank" rel="noopener" class="contact-link">Visit Website →</a>
                </div>
              </div>
              <% } %>
              
              <% if (tattooShop.priceRange) { %>
              <div class="info-item">
                <div class="info-label">💰 Price Range</div>
                <div class="info-value price-value"><%= tattooShop.priceRange %></div>
              </div>
              <% } %>
              
              <div class="info-item">
                <div class="info-label">🎨 Category</div>
                <div class="info-value">
                  <span class="category-badge"><%= tattooShop.category %></span>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Hours Panel -->
          <div class="hours-panel">
            <h3 class="panel-title">⏰ Opening Hours</h3>
            <% if (tattooShop.hours && tattooShop.hours.length > 0) { %>
              <div class="hours-list">
                <% tattooShop.hours.forEach(hour => { %>
                  <div class="hour-entry"><%= hour %></div>
                <% }) %>
              </div>
            <% } else { %>
              <p class="no-hours">Hours not available</p>
            <% } %>
          </div>
        </div>
      </section>

      <!-- Photo Gallery -->
      <% if (tattooShop.images && tattooShop.images.length > 0) { %>
      <section class="gallery-section">
        <div class="section-card">
          <h3 class="section-title">📸 Photo Gallery</h3>
          <div class="gallery-grid" data-images='<%- JSON.stringify(tattooShop.images) %>'>
            <% tattooShop.images.forEach((image, index) => { %>
              <div class="gallery-item">
                <img src="<%= image %>" alt="<%= tattooShop.businessName %> photo <%= index + 1 %>" onclick="openGallery(this, <%= index %>)" loading="lazy">
                <div class="gallery-overlay">
                  <span class="gallery-icon">🔍</span>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </section>
      <% } %>

      <!-- About Section -->
      <% if (tattooShop.about || tattooShop.description) { %>
      <section class="about-section">
        <div class="section-card">
          <h3 class="section-title">ℹ️ About This Tattoo Shop</h3>
          
          <% if (tattooShop.about) { %>
            <div class="about-text"><%- tattooShop.about %></div>
          <% } %>
          
          <% if (tattooShop.description) { %>
            <div class="about-text"><%= tattooShop.description %></div>
          <% } %>
        </div>
      </section>
      <% } %>

      <!-- Artist Specialties -->
      <% if (tattooShop.artistSpecialties) { %>
      <section class="menu-section">
        <div class="section-card">
          <h3 class="section-title">🎨 Artist Specialties</h3>
          <div class="about-text"><%- tattooShop.artistSpecialties %></div>
        </div>
      </section>
      <% } %>

      <!-- Atmosphere & Ambiance -->
      <% if (tattooShop.atmosphereDescription) { %>
      <section class="atmosphere-section">
        <div class="section-card">
          <h3 class="section-title">🏭 Atmosphere & Ambiance</h3>
          <div class="about-text"><%- tattooShop.atmosphereDescription %></div>
        </div>
      </section>
      <% } %>

      <!-- Piercing Services -->
      <% if (tattooShop.piercingServices) { %>
      <section class="dietary-section">
        <div class="section-card">
          <h3 class="section-title">⚡ Piercing Services</h3>
          <div class="about-text"><%- tattooShop.piercingServices %></div>
        </div>
      </section>
      <% } %>

      <!-- Best Times to Visit -->
      <% if (tattooShop.bestTimesToVisit) { %>
      <section class="timing-section">
        <div class="section-card">
          <h3 class="section-title">⏰ Best Times to Visit</h3>
          <div class="about-text"><%- tattooShop.bestTimesToVisit %></div>
        </div>
      </section>
      <% } %>

      <!-- What Makes Us Special -->
      <% if (tattooShop.uniqueSellingPoints) { %>
      <section class="unique-section">
        <div class="section-card">
          <h3 class="section-title">⭐ What Makes Us Special</h3>
          <div class="about-text"><%- tattooShop.uniqueSellingPoints %></div>
        </div>
      </section>
      <% } %>

      <!-- Local Area -->
      <% if (tattooShop.localContext) { %>
      <section class="local-section">
        <div class="section-card">
          <h3 class="section-title">📍 Local Area & Neighborhood</h3>
          <div class="about-text"><%- tattooShop.localContext %></div>
        </div>
      </section>
      <% } %>

      <!-- Gallery Modal -->
      <div id="galleryModal" class="gallery-modal">
        <span class="gallery-close" onclick="closeGallery()">&times;</span>
        <img class="gallery-content" id="galleryImage">
        <a class="gallery-prev" onclick="changeImage(-1)">&#10094;</a>
        <a class="gallery-next" onclick="changeImage(1)">&#10095;</a>
      </div>

      <!-- Customer Reviews -->
      <% if (topReviews && topReviews.length > 0) { %>
      <section class="reviews-section">
        <div class="section-card">
          <h3 class="section-title">💬 Customer Reviews</h3>
          <div class="reviews-container">
            <% topReviews.forEach((review, index) => { %>
              <div class="review-item">
                <div class="review-stars">⭐⭐⭐⭐⭐</div>
                <p class="review-quote">"<%= review.length > 120 ? review.substring(0, 120) + '...' : review %>"</p>
                <span class="review-author">— Customer #<%= index + 1 %></span>
              </div>
            <% }) %>
          </div>
        </div>
      </section>
      <% } %>
      
      <!-- Social Share -->
      <section class="social-share">
        <h4>📲 Share this tattoo shop:</h4>
        <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(seo.canonical) %>" target="_blank" class="share-btn share-facebook">
          📱 Facebook
        </a>
        <a href="https://twitter.com/intent/tweet?url=<%= encodeURIComponent(seo.canonical) %>&text=<%= encodeURIComponent('Check out ' + tattooShop.businessName + ' - a great tattoo shop!') %>" target="_blank" class="share-btn share-twitter">
          🐦 Twitter
        </a>
        <a href="https://wa.me/?text=<%= encodeURIComponent('Check out ' + tattooShop.businessName + ' - ' + seo.canonical) %>" target="_blank" class="share-btn share-whatsapp">
          📱 WhatsApp
        </a>
      </section>
      </article>
      
      <!-- Sidebar -->
      <aside class="restaurant-sidebar">
        <div class="sidebar-section">
          <h3 class="sidebar-title">🎨 Nearby Tattoo Shops</h3>
          <% if (nearbyShops && nearbyShops.length > 0) { %>
            <div class="nearby-list">
              <% nearbyShops.forEach(nearby => { %>
                <a href="/tattoo-shop/<%= nearby.slug %>" class="nearby-card">
                  <div class="nearby-image">
                    <% if (nearby.images && nearby.images.length > 0) { %>
                      <img src="<%= nearby.images[0] %>" alt="<%= nearby.businessName %>" loading="lazy">
                    <% } else { %>
                      <div class="nearby-placeholder">🎨</div>
                    <% } %>
                  </div>
                  <div class="nearby-info">
                    <h4 class="nearby-name"><%= nearby.businessName %></h4>
                    <p class="nearby-location">📍 <%= nearby.address.city %></p>
                    <div class="nearby-rating">⭐ <%= nearby.rating %> (<%= nearby.reviewCount %>)</div>
                  </div>
                </a>
              <% }) %>
            </div>
          <% } else { %>
            <p class="no-nearby">No nearby tattoo shops found.</p>
          <% } %>
        </div>
      </aside>
    </div>
  </main>
  
  <script src="/js/gallery.js"></script>

  <%- include('partials/footer') %>
</body>
</html>