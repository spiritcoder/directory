<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>
<body>
  <%- include('partials/header') %>
  
  <!-- Country Hero -->
  <section class="page-hero">
    <div class="container">
      <h1><%= country.flag %> Vegan Restaurants in <%= country.name %></h1>
      <% if (totalRegions === 0) { %>
        <p>No vegan restaurants found in <%= country.name %> yet. Check back soon for updates!</p>
      <% } else { %>
        <p>Explore <%= totalRestaurants %> plant-based restaurants across <%= totalRegions %> <%= country.regionType.toLowerCase() %></p>
      <% } %>
    </div>
  </section>

  <main class="container">
    <!-- Regions Grid -->
    <section class="states-grid">
      <h2>Browse by <%= country.regionType %></h2>
      <% if (totalRegions === 0) { %>
        <div class="empty-state">
          <h3>🔍 No regions found</h3>
          <p>We haven't found any vegan restaurants in <%= country.name %> yet.</p>
          <p>Help us grow by suggesting restaurants in your area!</p>
        </div>
      <% } else { %>
        <div class="grid">
          <% regions.forEach(region => { %>
            <div class="state-card">
              <a href="/state/<%= region.slug %>">
                <h3><%= region.name %></h3>
                <p><%= region.count %> restaurants</p>
                <% if (region.avgRating) { %>
                  <span class="avg-rating">⭐ <%= region.avgRating %></span>
                <% } %>
              </a>
            </div>
          <% }) %>
        </div>
      <% } %>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>
</html>