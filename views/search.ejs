<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>
<body>
  <%- include('partials/header') %>
  
  <!-- Search Hero Section -->
  <section class="search-hero">
    <div class="hero-background">
      <div class="hero-overlay"></div>
    </div>
    <div class="hero-content">
      <div class="container">
        <h1 class="hero-title">🔍 Find Your Perfect Tattoo Shop</h1>
        <p class="hero-subtitle">Discover amazing tattoo artists and shops across all 50 US states</p>
        
        <%- include('partials/search-form', { 
          searchQuery, 
          selectedState, 
          selectedCategory, 
          allStates, 
          allCategories 
        }) %>
      </div>
    </div>
  </section>

  <main class="container">
    <!-- Search Results Section -->
    <section class="search-results">
      <%- include('partials/results-header', { 
        isDefaultView, 
        searchQuery, 
        selectedState, 
        selectedCategory, 
        resultCount 
      }) %>
        
      <% if (restaurants.length > 0) { %>
        <%- include('partials/restaurant-grid', { restaurants }) %>
          
        <%- include('partials/pagination', { 
          totalPages, 
          currentPage, 
          hasPrevPage, 
          hasNextPage, 
          prevPage, 
          nextPage, 
          searchQuery, 
          selectedState, 
          selectedCategory 
        }) %>
      <% } else { %>
        <%- include('partials/no-results') %>
      <% } %>
    </section>
    
    <!-- Search Tips Section -->
    <%- include('partials/search-tips') %>

    <!-- Popular Searches Section -->
    <% if (!searchQuery && !selectedState && !selectedCategory && restaurants.length === 0) { %>
      <%- include('partials/popular-searches', { allCategories, allStates }) %>
    <% } %>
  </main>

  <%- include('partials/footer') %>
</body>
</html>