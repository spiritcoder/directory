{
  "name": "us-tattoo-shop-directory",
  "version": "1.0.0",
  "description": "A comprehensive directory of tattoo shops across the United States",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "build:css": "cleancss -o public/css/style.min.css public/css/style.css",
    "build": "npm run build:css",
    "prod": "npm run build && NODE_ENV=production node app.js",
    "seed": "node scripts/seed-data.js",
    "ai-descriptions": "node scripts/generate-ai-descriptions.js",
    "audit-categories": "node scripts/audit-categories.js",
    "harmonize-categories": "node scripts/harmonize-categories.js",
    "generate-sitemap": "node utils/sitemap.js"
  },
  "dependencies": {
    "axios": "^1.5.0",
    "compression": "^1.8.1",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-sitemap": "^1.8.0",
    "helmet": "^7.0.0",
    "mongoose": "^7.5.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "clean-css-cli": "^5.6.2"
  }
}
