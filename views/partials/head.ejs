<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <!-- SEO Meta Tags -->
  <title><%= seo.title %></title>
  <meta name="description" content="<%= seo.description %>">
  <link rel="canonical" href="<%= seo.canonical %>">
  
  <!-- Open Graph -->
  <meta property="og:title" content="<%= seo.title %>">
  <meta property="og:description" content="<%= seo.description %>">
  <meta property="og:url" content="<%= seo.canonical %>">
  <meta property="og:type" content="website">
  <meta property="og:image" content="<%= seo.ogImage %>">
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= seo.title %>">
  <meta name="twitter:description" content="<%= seo.description %>">
  <meta name="twitter:image" content="<%= seo.ogImage %>">
  
  <!-- Favicon -->
  <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon/favicon-16x16.png">
  <link rel="manifest" href="/images/favicon/site.webmanifest">
  <link rel="mask-icon" href="/images/favicon/safari-pinned-tab.svg" color="#2d5a27">
  <link rel="shortcut icon" href="/images/favicon/favicon.ico">
  <meta name="msapplication-TileColor" content="#2d5a27">
  <meta name="msapplication-config" content="/images/favicon/browserconfig.xml">
  <meta name="theme-color" content="#2d5a27">
  
  <!-- Stylesheets -->
  <% if (process.env.NODE_ENV === 'production') { %>
    <link rel="stylesheet" href="/css/style.min.css">
  <% } else { %>
    <link rel="stylesheet" href="/css/style.css">
  <% } %>
  
  <% if (typeof restaurant !== 'undefined') { %>
  <!-- Structured Data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Restaurant",
    "name": "<%= restaurant.businessName %>",
    "image": <%= restaurant.images && restaurant.images.length > 0 ? JSON.stringify(restaurant.images.map(img => seo.canonical.split('/').slice(0,3).join('') + img)) : '[]' %>,
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "<%= restaurant.address.street %>",
      "addressLocality": "<%= restaurant.address.city %>",
      "addressRegion": "<%= restaurant.address.state %>",
      "postalCode": "<%= restaurant.address.zipCode %>",
      "addressCountry": "US"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "<%= restaurant.rating %>",
      "reviewCount": "<%= restaurant.reviewCount %>"
    },
    "servesCuisine": "Vegan",
    "priceRange": "<%= restaurant.priceRange || '$' %>",
    <% if (restaurant.phone) { %>"telephone": "<%= restaurant.phone %>",<% } %>
    <% if (restaurant.website) { %>"url": "<%= restaurant.website %>",<% } %>
    "openingHours": <%= restaurant.hours ? JSON.stringify(restaurant.hours) : '[]' %>
  }
  </script>
  <% } %>
</head>